# Arc network the app runs on: testnet or mainnet (keep both in sync).
ARC_NETWORK=testnet
NEXT_PUBLIC_ARC_NETWORK=testnet

# Public Arc RPCs (no API key). Used by Foundry (foundry.toml) for deploys.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Optional: RPC the app and indexer use instead of the public one for ARC_NETWORK
# (e.g. an Alchemy, QuickNode, dRPC or Blockdaemon URL). Leave empty to use the public RPC.
ARC_RPC_URL=

# Deployed contracts/src/StoreRegistry.sol
STORE_REGISTRY_ADDRESS=
NEXT_PUBLIC_STORE_REGISTRY_ADDRESS=
REGISTRY_ADMIN=
REGISTRY_RELAYER=

# Postgres (docker compose up -d postgres)
DATABASE_URL=postgres://jupa:jupa@localhost:5432/jupa

# Circle (App Kit / Wallets / Gateway). Never commit real values.
# CIRCLE_API_KEY: Circle Console > API & Client Keys (server only).
# NEXT_PUBLIC_CIRCLE_APP_ID: Wallets > User Controlled > Configurator. Email OTP also needs SMTP set up there.
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
# Google Cloud OAuth Web client ID. Add the same ID under Circle Configurator > Social Logins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Relayer that pays gas (USDC on Arc) to register stores. Testnet only; fund from faucet.circle.com.
# Generate one with: cast wallet new
RELAYER_PRIVATE_KEY=

# Deployer: use a Foundry keystore (cast wallet import), not a raw key here.

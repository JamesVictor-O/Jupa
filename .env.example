# Arc network the app runs on: testnet or mainnet (keep both in sync).
ARC_NETWORK=testnet
NEXT_PUBLIC_ARC_NETWORK=testnet

# Public Arc RPCs (no API key). Used by Foundry (foundry.toml) for deploys.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Optional: RPC the app and indexer use instead of the public one for ARC_NETWORK
# (e.g. an Alchemy, QuickNode, dRPC or Blockdaemon URL). Leave empty to use the public RPC.
ARC_RPC_URL=

# Deployed contracts/src/StoreRegistry.sol
STORE_REGISTRY_ADDRESS=
NEXT_PUBLIC_STORE_REGISTRY_ADDRESS=
# Deployment block used by the indexer to replay missed ChargePaid events after restarts.
STORE_REGISTRY_DEPLOYMENT_BLOCK=
CROSSCHAIN_PAYMENT_FACTORY_ADDRESS=
NEXT_PUBLIC_CROSSCHAIN_PAYMENT_FACTORY_ADDRESS=
CROSSCHAIN_FACTORY_DEPLOYMENT_BLOCK=
REGISTRY_ADMIN=
REGISTRY_RELAYER=

# Local Postgres (docker compose up -d postgres). On Vercel, DATABASE_URL should
# be Supabase's transaction-pooler URI; DIRECT_URL is only for schema tooling.
DATABASE_URL=postgres://jupa:jupa@localhost:5432/jupa
DIRECT_URL=

# Circle (App Kit / Wallets / Gateway). Never commit real values.
# CIRCLE_API_KEY: Circle Console > API & Client Keys (server only).
# CIRCLE_APP_ID: Wallets > User Controlled > Configurator. It is read by the
# server-rendered pages and passed to Circle's browser SDK. Email OTP also needs SMTP set up there.
CIRCLE_API_KEY=
CIRCLE_APP_ID=
# Google Cloud OAuth Web client ID. Add the same ID under Circle Configurator > Social Logins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Runtime relayer that pays USDC gas on Arc to register stores and settle funded receivers.
# Local/testnet only. Mainnet must use a managed signer integration; deployment uses
# a Foundry encrypted keystore via --account and never reads this value.
RELAYER_PRIVATE_KEY=

# Deployer: use a Foundry keystore (cast wallet import), not a raw key here.
